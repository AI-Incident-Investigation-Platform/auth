[service]
port = 8001
public_host = "host.docker.internal"

[gateway]
rate_limit_average = 10
rate_limit_burst = 10
rate_limit_period = "1s"

[auth]
private_key_path = "keys/private.pem"
access_token_ttl_minutes = 15
refresh_token_ttl_days = 30
cookie_secure = false

[logging]
level = "INFO"

[database]
postgres_host = "host.docker.internal"
postgres_port = 5432
postgres_db = "auth"
postgres_username = "auth"
postgres_password = "change-me"

[cache]
host = "host.docker.internal"
port = 6379
password = "change-me"
db = 0
key_prefix = "auth:"

[registry]
consul_url = "http://host.docker.internal:8500"

[tracing]
otlp_endpoint = "http://host.docker.internal:4318"
