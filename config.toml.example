[service]
port = 8001

[auth]
private_key_path = "keys/private.pem"
access_token_ttl_minutes = 15
refresh_token_ttl_days = 30
cookie_secure = false

[logging]
level = "INFO"
slow_request_ms = 1000

[database]
postgres_host = "postgres"
postgres_port = 5432
postgres_db = "auth"
postgres_username = "auth"
postgres_password = "change-me"

[cache]
host = "dragonfly"
port = 6379
password = "change-me"
db = 0
key_prefix = "auth:"

[tracing]
otlp_endpoint = "http://alloy.infra:4318"
